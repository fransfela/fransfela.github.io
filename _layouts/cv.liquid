---
layout: default
---
{% assign localized_resume = site.active_lang | prepend: 'resume_' %}
{% unless site.data[localized_resume] %}
  <!-- use data from _data/LANG/cv.yml -->
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">
        {{ page.title }}
        {% if page.cv_pdf %}
          <a
            {% if page.cv_pdf contains '://' %}
              href="{{ page.cv_pdf }}"
            {% else %}
              href="{{ page.cv_pdf | prepend: '/' | prepend: site.active_lang | prepend: '/assets/pdf/' | prepend: site.baseurl }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            class="float-right"
          >
            <i class="fa-solid fa-file-pdf"></i>
          </a>
        {% endif %}
      </h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </header>

    <article>
      <div class="cv">
        {% for entry in site.data[site.active_lang].cv %}
          <a class="anchor" id="{{ entry.title }}"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">{{ entry.title }}</h3>
            <div>
              {% if entry.type == 'list' %}
                {% include cv/list.liquid %}
              {% elsif entry.type == 'map' %}
                {% include cv/map.liquid %}
              {% elsif entry.type == 'nested_list' %}
                {% include cv/nested_list.liquid %}
              {% elsif entry.type == 'time_table' %}
                {% include cv/time_table.liquid %}
              {% elsif entry.type == 'list_groups' %}
                {% include cv/list_groups.liquid %}
              {% else %}
                {{ entry.contents }}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </article>
  </div>
{% else %}
  <!-- use data from assets/json/resume_LANG.json -->
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">
        {{ page.title }}
        {% if page.cv_pdf %}
          <a
            {% if page.cv_pdf contains '://' %}
              href="{{ page.cv_pdf }}"
            {% else %}
              href="{{ page.cv_pdf | prepend: '/' | prepend: site.active_lang | prepend: '/assets/pdf/' | prepend: site.baseurl }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            class="float-right"
          >
            <i class="fa-solid fa-file-pdf"></i>
          </a>
        {% endif %}
      </h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </header>

    <article>
      <div class="cv">
        {% for data in site.data[localized_resume] %}
          {% if site.jsonresume and site.jsonresume.size > 0 %}
            {% unless site.jsonresume contains data[0] %}
              {% continue %}
            {% endunless %}
          {% endif %}
          {% if data[0] == 'meta' or data[1].size == 0 %} {% continue %} {% endif %}
          {% assign localized_title = data[0] %}
          <a class="anchor" id="{{ site.data[site.active_lang].strings.cv[localized_title] }}"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">{{ site.data[site.active_lang].strings.cv[localized_title] }}</h3>
            <div>
              {% case data[0] %}
                {% when 'basics' %}
                  {% include resume/basics.liquid %}
                {% when 'education' %}
                  {% include resume/education.liquid %}
                {% when 'work' %}
                  {% include resume/work.liquid %}
                {% when 'volunteer' %}
                  {% include resume/volunteer.liquid %}
                {% when 'side_activities' %}
                  {% include resume/volunteer.liquid %}
                {% when 'projects' %}
                  {% include resume/projects.liquid %}
                {% when 'awards' %}
                  {% include resume/awards.liquid %}
                {% when 'skills' %}
                  {% include resume/skills.liquid %}
                {% when 'publications' %}
                  {% include resume/publications.liquid %}
                {% when 'languages' %}
                  {% include resume/languages.liquid %}
                {% when 'interests' %}
                  {% include resume/interests.liquid %}
                {% when 'certificates' %}
                  {% include resume/certificates.liquid %}
                {% when 'references' %}
                  {% include resume/references.liquid %}
                {% else %}

              {% endcase %}
            </div>
          </div>
        {% endfor %}
      </div>
    </article>
  </div>
{% endunless %}

<style>
  /* Flowing timeline look: flat sections instead of boxed cards */
  .cv .card {
    background: transparent;
    border: 0;
    box-shadow: none;
    padding: 0 !important;
    margin-top: 2.5rem !important;
  }
  .cv .card-title {
    font-weight: 300;
    font-size: 1.6rem;
    letter-spacing: 0.01em;
    margin-bottom: 1rem;
  }
  .cv .card-title::after {
    content: '';
    display: block;
    width: 2.5rem;
    height: 2px;
    margin-top: 0.4rem;
    background: var(--global-theme-color);
    border-radius: 2px;
  }
  .cv .list-group-item {
    position: relative;
    background: transparent;
    border: 0;
    border-left: 2px solid var(--global-divider-color);
    padding: 0.4rem 0 1.4rem 1.5rem;
    margin-left: 0.4rem;
  }
  .cv .list-group-item::before {
    content: '';
    position: absolute;
    left: -0.4rem;
    top: 0.9rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--global-bg-color);
    border: 2px solid var(--global-theme-color);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .cv .list-group-item:hover::before {
    background: var(--global-theme-color);
    transform: scale(1.25);
  }
  .cv .list-group-item:last-child {
    border-left-color: transparent;
    background-image: linear-gradient(var(--global-divider-color), transparent);
    background-size: 2px 60%;
    background-repeat: no-repeat;
    background-position: 0 0;
  }
  .cv .badge {
    background: transparent !important;
    color: var(--global-theme-color) !important;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding-left: 0;
  }
  .cv .location,
  .cv .items {
    color: var(--global-text-color-light);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cv .list-group-item {
      animation: cv-fade 0.5s ease both;
    }
    @keyframes cv-fade {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: none; }
    }
  }
</style>
