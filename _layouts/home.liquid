---
layout: default
---
{% assign t = site.data[site.active_lang].strings.home %}
{% assign socials = site.data.socials %}

{% comment %}
  TODO: replace the bitmoji below with a real photograph (assets/img).
  TODO: the facts list comes from the CV. Every number must be confirmed and cleared with my employer before launch.
  TODO: the "Get in touch" link points to LinkedIn until contact_email is set (Phase 5).
{% endcomment %}

<div class="home">
  <section class="home-hero">
    <div class="home-hero-text">
      <h1 class="home-name">Randy F. Fela</h1>
      <p
        id="typed-line"
        class="home-role"
        data-lines="{{ t.typed | jsonify | escape }}"
      >
        <span class="typed-text">{{ t.typed[0] }}</span><span class="typed-cursor" aria-hidden="true">|</span>
      </p>
      <p class="home-positioning">{{ t.positioning }}</p>
      <p class="home-links">
        <a href="{{ '/playground/' | relative_url }}">{{ t.playground }}</a>
        <a href="{{ '/publications/' | relative_url }}">{{ t.view_publications }}</a>
        <a href="https://www.linkedin.com/in/{{ socials.linkedin_username }}">{{ t.get_in_touch }}</a>
      </p>
    </div>
    <img
      class="home-figure"
      src="{{ '/assets/img/bitmoji-full-vector.png' | relative_url }}"
      alt="{{ t.photo_alt }}"
      height="260"
    >
  </section>

  <ul class="home-facts">
    {% for fact in t.tiles %}
      <li>{{ fact }}</li>
    {% endfor %}
  </ul>

  <section class="home-section">
    <h2>
      <a href="{{ '/publications/' | relative_url }}">{{ t.selected_publications }}</a>
    </h2>
    <div class="publications">
      {% bibliography --group_by none --query @*[key=fela2023comparison]* %}
      {% bibliography --group_by none --query @*[key=fela2022assessor]* %}
      {% bibliography --group_by none --query @*[key=fela2021perceptual_ml]* %}
    </div>
  </section>

  <section class="home-section">
    <h2>
      <a href="{{ '/projects/' | relative_url }}">{{ t.featured_projects }}</a>
    </h2>
    {% assign featured = site.projects | where_exp: 'p', "p.slug == 'hoassr_dataset' or p.slug == 'batchmailer'" | sort: 'importance' %}
    <div class="projects">
      <div class="row row-cols-1 row-cols-md-3">
        {% for project in featured %}
          {% include projects.liquid %}
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="home-section">
    <h2>
      <a href="{{ '/zettelkasten/' | relative_url }}">{{ t.latest_notes }}</a>
    </h2>
    {% assign notes = site.posts
      | where_exp: 'post', "post.tags contains 'living-note' or post.tags contains 'living-book'"
      | sort: 'date'
      | reverse
    %}
    <ul class="list-unstyled">
      {% for post in notes limit: 3 %}
        <li class="mb-3">
          <a href="{{ post.url | relative_url }}"
            ><strong>{{ post.title }}</strong></a
          ><br>
          <span class="home-note-desc">{{ post.description | strip_html | truncate: 150 }}</span><br>
          <small class="home-note-desc">{{ post.date | date: '%Y-%m-%d' }}</small>
        </li>
      {% endfor %}
    </ul>
  </section>
</div>

<script src="{{ '/assets/js/typewriter.js' | relative_url }}" defer></script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Randy F. Fela",
    "jobTitle": "Perceptual Audio-visual Evaluation Engineer",
    "url": "{{ site.url }}{{ site.baseurl }}/",
    "sameAs": [
      "https://www.linkedin.com/in/{{ socials.linkedin_username }}",
      "https://orcid.org/{{ socials.orcid_id }}",
      "https://scholar.google.com/citations?user={{ socials.scholar_userid }}",
      "https://www.scopus.com/authid/detail.uri?authorId={{ socials.scopus_id }}",
      "https://www.youtube.com/@{{ socials.youtube_id }}"
    ]
  }
</script>

<style>
  .home-hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem 0 1rem;
  }
  .home-hero-text {
    flex: 1 1 auto;
    min-width: 0;
  }
  .home-name {
    font-size: 3rem;
    font-weight: 300;
    margin-bottom: 0.25rem;
  }
  .home-role {
    color: var(--global-theme-color);
    font-size: 1.35rem;
    min-height: 2rem;
    margin-bottom: 1.25rem;
  }
  .typed-cursor {
    animation: home-blink 1s steps(2, start) infinite;
  }
  @keyframes home-blink {
    to {
      visibility: hidden;
    }
  }
  .home-positioning {
    max-width: 38rem;
    font-size: 1.1rem;
    line-height: 1.65;
  }
  .home-links a {
    margin-right: 1.5rem;
    border-bottom: 1px solid var(--global-theme-color);
  }
  .home-figure {
    flex: 0 0 auto;
    height: 260px;
    width: auto;
  }
  .home-facts {
    max-width: 42rem;
    margin: 1.5rem 0 0;
    padding-left: 1.1rem;
    line-height: 1.7;
  }
  .home-section {
    margin-top: 2.5rem;
  }
  .home-section h2 a {
    color: inherit;
  }
  .home-note-desc {
    color: var(--global-text-color-light);
  }
  @media (max-width: 576px) {
    .home-hero {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
    .home-name {
      font-size: 2.25rem;
    }
    .home-figure {
      height: 200px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .typed-cursor {
      animation: none;
    }
  }
</style>
