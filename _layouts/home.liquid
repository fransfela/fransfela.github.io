---
layout: default
---

{% assign t = site.data[site.active_lang].strings.home %}
{% assign socials = site.data.socials %}

{% comment %}
  TODO: replace the bitmoji below with a real photograph (assets/img).
  TODO: every number in the proof tiles must be confirmed and cleared with my employer before launch.
  TODO: the "Get in touch" button points to LinkedIn until contact_email is set (Phase 5).
{% endcomment %}

<div class="home">
  <section class="home-hero row align-items-center">
    <div class="col-md-8 order-2 order-md-1">
      <h1 class="home-name">Randy F. Fela</h1>
      <p class="home-role">{{ t.role }}</p>
      <p class="home-positioning">{{ t.positioning }}</p>
      <div class="home-buttons">
        <a href="https://www.linkedin.com/in/{{ socials.linkedin_username }}" class="btn btn-primary btn-lg z-depth-0">{{ t.get_in_touch }}</a>
        <a href="{{ '/publications/' | relative_url }}" class="btn btn-outline-primary btn-lg z-depth-0">{{ t.view_publications }}</a>
      </div>
    </div>
    <div class="col-md-4 order-1 order-md-2 text-center mb-4 mb-md-0">
      <img
        class="home-photo"
        src="{{ '/assets/img/bitmoji-closeup.png' | relative_url }}"
        alt="{{ t.photo_alt }}"
        width="220"
        height="220"
      >
    </div>
  </section>

  <section class="home-tiles row row-cols-1 row-cols-md-3">
    {% for tile in t.tiles %}
      <div class="col mb-3">
        <div class="card h-100 z-depth-0 home-tile">
          <div class="card-body">
            <p class="card-text">{{ tile }}</p>
            <p class="home-source">{{ t.source_cv }}</p>
          </div>
        </div>
      </div>
    {% endfor %}
  </section>

  <section class="home-section">
    <h2>
      <a href="{{ '/publications/' | relative_url }}">{{ t.selected_publications }}</a>
    </h2>
    <div class="publications">
      {% bibliography --group_by none --query @*[key=fela2023comparison]* %}
      {% bibliography --group_by none --query @*[key=fela2022assessor]* %}
      {% bibliography --group_by none --query @*[key=fela2021perceptual_ml]* %}
    </div>
  </section>

  <section class="home-section">
    <h2>
      <a href="{{ '/projects/' | relative_url }}">{{ t.featured_projects }}</a>
    </h2>
    {% assign featured = site.projects | where_exp: 'p', "p.slug == 'hoassr_dataset' or p.slug == 'batchmailer'" | sort: 'importance' %}
    <div class="projects">
      <div class="row row-cols-1 row-cols-md-3">
        {% for project in featured %}
          {% include projects.liquid %}
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="home-section">
    <h2>
      <a href="{{ '/zettelkasten/' | relative_url }}">{{ t.latest_notes }}</a>
    </h2>
    {% assign notes = site.posts
      | where_exp: 'post', "post.tags contains 'living-note' or post.tags contains 'living-book'"
      | sort: 'date'
      | reverse
    %}
    <ul class="list-unstyled">
      {% for post in notes limit: 3 %}
        <li class="mb-3">
          <a href="{{ post.url | relative_url }}"
            ><strong>{{ post.title }}</strong></a
          ><br>
          <span class="home-note-desc">{{ post.description | strip_html | truncate: 150 }}</span><br>
          <small class="home-source">{{ post.date | date: '%Y-%m-%d' }}</small>
        </li>
      {% endfor %}
    </ul>
  </section>
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Randy F. Fela",
    "jobTitle": "Perceptual Audio-visual Evaluation Engineer",
    "url": "{{ site.url }}{{ site.baseurl }}/",
    "sameAs": [
      "https://www.linkedin.com/in/{{ socials.linkedin_username }}",
      "https://orcid.org/{{ socials.orcid_id }}",
      "https://scholar.google.com/citations?user={{ socials.scholar_userid }}",
      "https://www.scopus.com/authid/detail.uri?authorId={{ socials.scopus_id }}",
      "https://www.youtube.com/@{{ socials.youtube_id }}"
    ]
  }
</script>

<style>
  .home-hero {
    padding: 2rem 0;
  }
  .home-name {
    font-size: 2.75rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .home-role {
    color: var(--global-theme-color);
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }
  .home-positioning {
    font-size: 1.15rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  .home-buttons .btn {
    margin: 0 0.5rem 0.5rem 0;
  }
  .home-photo {
    border-radius: 50%;
    object-fit: cover;
  }
  .home-tile {
    border-left: 4px solid var(--global-theme-color);
  }
  .home-source {
    color: var(--global-text-color-light);
    font-size: 0.8rem;
    margin: 0;
  }
  .home-section {
    margin-top: 2.5rem;
  }
  .home-section h2 a {
    color: inherit;
  }
  .home-note-desc {
    color: var(--global-text-color-light);
  }
</style>
